# Copy to `.env` (gitignored) and point at your backend.
#
# ONLY vars prefixed EXPO_PUBLIC_ reach the app bundle — and they are
# PUBLIC. Anyone with the .apk/.ipa or the web build can read them.
# Never put an API secret, service-role key or signing token here;
# those belong in the backend repo.
#
# Nothing fills this in for you. Set it yourself, or ask the agent to
# wire it — in a Tarrs sandbox the agent reads the sibling backend
# service's URL from the project's infra spec and writes it into `.env`
# directly (env vars are managed as files; there is no env injection).
EXPO_PUBLIC_API_URL=http://localhost:4000
