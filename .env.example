# Copy to `.env` (gitignored) and point at your backend.
#
# ONLY vars prefixed EXPO_PUBLIC_ reach the app bundle — and they are
# PUBLIC. Anyone with the .apk/.ipa or the web build can read them.
# Never put an API secret, service-role key or signing token here;
# those belong in the backend repo.
#
# Tarrs injects the sibling backend service's sandbox URL here when the
# project has one (e.g. https://api-<id>.dev.tarrsapp.io).
EXPO_PUBLIC_API_URL=http://localhost:4000
